{
  "name": "cashx-10000-nft-mint",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/validate-site-config.mjs && vite build",
    "start": "vite preview",
    "test": "pnpm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist",
    "contract:compile": "node contracts/scripts/compile.mjs",
    "contract:test": "node --test contracts/test/*.test.mjs",
    "contract:check": "pnpm run contract:compile && pnpm run contract:test",
    "contract:deploy": "pnpm run contract:compile && node contracts/scripts/deploy.mjs"
  },
  "dependencies": {
    "ethers": "6.15.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@openzeppelin/contracts": "5.0.2",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "ganache": "7.9.2",
    "solc": "0.8.24",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vite": "8.0.13"
  },
  "type": "module"
}
